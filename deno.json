{
	"nodeModulesDir": "auto",
	"exclude": [".wrangler"],
	"tasks": {
		"dev": "wrangler dev",
		"check": "deno check && dx biome check .",
		"check:unsafe": "deno check && dx biome check --write --unsafe .",
		"build": "deno run --allow-read --allow-write scripts/build-spots.js && dx vite build"
	}
}
